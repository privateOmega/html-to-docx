{
  "name": "html-to-docx",
  "version": "1.8.0",
  "description": "HTML to DOCX converter",
  "keywords": [
    "html",
    "docx",
    "html-to-docx",
    "html to docx",
    "office",
    "word"
  ],
  "scripts": {
    "test": "vitest run",
    "lint": "oxlint",
    "validate": "pnpm lint && pnpm format:check",
    "build": "tsdown",
    "prepare": "husky",
    "example": "pnpm build && node example/example.js && node example/example-node.cjs",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc",
    "check:package": "pnpm build && attw --pack . && publint"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/privateOmega/html-to-docx.git"
  },
  "author": "privateOmega <privateOmega@protonmail.com>",
  "contributors": [
    "amrita-syn <amrita.yadav@synapsica.com>",
    "charuthaB <charutha.bhaskar@synapsica.com>",
    "hanagejet",
    "kurukururuu <apriansyah.fajar94@gmail.com>",
    "erenard",
    "KeithGillette",
    "juralio-james",
    "nicolasiscoding <nicolascoding@gmail.com>",
    "zedtux <zedtux@zedroot.org>",
    "hlerebours",
    "hakjeri",
    "tasola"
  ],
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "bugs": {
    "url": "https://github.com/privateOmega/html-to-docx/issues"
  },
  "homepage": "https://github.com/privateOmega/html-to-docx#readme",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/color-name": "^1.1.5",
    "@types/image-to-base64": "^2.1.2",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^22.20.7",
    "@types/virtual-dom": "^2.1.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "oxfmt": "0.80.0",
    "oxlint": "^1.95.0",
    "publint": "^0.3.25",
    "tsdown": "0.23.7",
    "typescript": "7.0.2",
    "vitest": "^5.1.2"
  },
  "dependencies": {
    "@oozcitak/dom": "1.15.6",
    "@oozcitak/util": "8.3.4",
    "color-name": "^1.1.4",
    "html-entities": "^2.3.3",
    "html-to-vdom": "^0.7.0",
    "image-size": "^1.0.0",
    "image-to-base64": "^2.2.0",
    "jszip": "^3.7.1",
    "mime-types": "^2.1.35",
    "nanoid": "^3.1.25",
    "virtual-dom": "^2.1.1",
    "xmlbuilder2": "2.1.2"
  },
  "lint-staged": {
    "src/**/*.js": [
      "oxlint --fix",
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "packageManager": "pnpm@12.23.0",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.cts"
}
